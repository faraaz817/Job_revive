# Resume documents — contain phone number, email, and other personal details
Faraaz_Mohammed_Resume*.docx
Faraaz_Mohammed_Resume*.pdf

# Renderer dependencies
_build/node_modules/
_build/package-lock.json

# Resume sources carry phone number and email — kept local only. Per application, jd.md and
# notes.md are tracked (no contact details); resume.md and the rendered .docx/.pdf are not.
base_resume.md
applications/*/resume.md

# Render-check artefacts from the tailor-resume skill's page-proof step. Same
# contact details as the final PDF, so they must not be tracked either.
applications/*/draft.docx
applications/*/draft.pdf

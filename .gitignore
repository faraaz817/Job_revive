# Renderer dependencies
_build/node_modules/
_build/package-lock.json

# Old template resume — superseded by the tracked Base one, kept out of git.
Faraaz_Mohammed_Resume.docx

# Per-application tailored resumes stay local; base_resume.md and the Base .docx/.pdf are tracked
# on purpose so employers/recruiters can find the current resume in this repo.
applications/*/resume.md
applications/*/*.docx
applications/*/*.pdf

# Page-proof artefacts from _build/proof.sh. They carry the same contact details
# as the final PDF, and proofing base_resume.md drops them at the repo root.
draft.docx
draft.pdf
